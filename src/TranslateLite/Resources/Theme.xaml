<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== Design tokens ==================== -->
  <!--
    Direction: low-contrast, airy surfaces. Cards are translucent so the soft
    backdrop glow shows through; edges are hairlines, shadows are layered and
    light, and colour is used only as a quiet accent.
  -->

  <!-- Text: softened, but still comfortably legible -->
  <SolidColorBrush x:Key="BrushTextPrimary" Color="#2C3644" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#5B6676" />
  <SolidColorBrush x:Key="BrushTextMuted" Color="#8B95A3" />
  <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFF" />

  <!-- Translucent glass surfaces -->
  <SolidColorBrush x:Key="GlassFill" Color="#B4FAFCFE" />
  <SolidColorBrush x:Key="GlassFillSoft" Color="#A8F0F4F9" />
  <SolidColorBrush x:Key="BrushSurface" Color="#B4FAFCFE" />
  <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="BrushSurfaceSunken" Color="#66F1F5F9" />
  <SolidColorBrush x:Key="BrushCanvas" Color="#F0F3F8" />
  <!-- Input fields need a readable edge; panels intentionally do not -->
  <SolidColorBrush x:Key="BrushFieldFill" Color="#C6F4F8FC" />
  <SolidColorBrush x:Key="BrushFieldStroke" Color="#64768A80" />

  <!-- Hairline edges: bright top highlight fading to a soft dark bottom -->
  <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#9CFFFFFF" Offset="0" />
    <GradientStop Color="#1E36445A" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GlassHighlight" Color="#70FFFFFF" />
  <SolidColorBrush x:Key="BrushBorder" Color="#203C4A5E" />
  <SolidColorBrush x:Key="BrushBorderStrong" Color="#383C4A5E" />
  <SolidColorBrush x:Key="BrushDivider" Color="#2A3C4A5E" />

  <!-- Restrained accent: muted slate blue -->
  <SolidColorBrush x:Key="BrushAccent" Color="#5B7A9E" />
  <SolidColorBrush x:Key="BrushAccentHover" Color="#4F6D90" />
  <SolidColorBrush x:Key="BrushAccentPressed" Color="#456080" />
  <SolidColorBrush x:Key="BrushAccentSoft" Color="#2A6E8FB0" />
  <SolidColorBrush x:Key="BrushSelection" Color="#306E8FB0" />
  <SolidColorBrush x:Key="BrushAccentGlow" Color="#406E8FB0" />

  <!-- Danger, desaturated -->
  <SolidColorBrush x:Key="BrushDanger" Color="#B4676B" />
  <SolidColorBrush x:Key="BrushDangerSoft" Color="#22B4676B" />

  <!-- Scrollbar -->
  <SolidColorBrush x:Key="BrushScrollThumb" Color="#305A6676" />
  <SolidColorBrush x:Key="BrushScrollThumbHover" Color="#5E5A6676" />

  <!-- ==================== Backdrop ==================== -->
  <!-- Very low-contrast gradient plus two barely-there light blooms. The
       translucent panels sit on top of this, which is what gives the glass
       its depth without a real blur-behind API. -->
  <DrawingBrush x:Key="AppBackdrop" Stretch="Fill"
                Viewport="0,0,1,1" ViewportUnits="RelativeToBoundingBox">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,1,1" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#F1F6FC" Offset="0" />
              <GradientStop Color="#EAF0F8" Offset="0.52" />
              <GradientStop Color="#E2EAF4" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,1,1" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.06,0.02" GradientOrigin="0.06,0.02"
                                 RadiusX="0.95" RadiusY="0.95">
              <GradientStop Color="#2E86B4DE" Offset="0" />
              <GradientStop Color="#0086B4DE" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,1,1" />
          </GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush Center="0.96,0.98" GradientOrigin="0.96,0.98"
                                 RadiusX="0.78" RadiusY="0.78">
              <GradientStop Color="#24C7BEDA" Offset="0" />
              <GradientStop Color="#00C7BEDA" Offset="1" />
            </RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ==================== Fine-grain noise ==================== -->
  <!-- Sub-pixel specks at very low alpha: texture you feel more than see. -->
  <DrawingBrush x:Key="NoiseOverlay" TileMode="Tile" Stretch="None"
                Viewport="0,0,140,140" ViewportUnits="Absolute"
                Viewbox="0,0,140,140" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#0A2C3644">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="9,14,0.7,0.7" />
              <RectangleGeometry Rect="37,6,0.7,0.7" />
              <RectangleGeometry Rect="62,29,0.7,0.7" />
              <RectangleGeometry Rect="88,11,0.7,0.7" />
              <RectangleGeometry Rect="121,24,0.7,0.7" />
              <RectangleGeometry Rect="18,52,0.7,0.7" />
              <RectangleGeometry Rect="48,71,0.7,0.7" />
              <RectangleGeometry Rect="73,58,0.7,0.7" />
              <RectangleGeometry Rect="104,76,0.7,0.7" />
              <RectangleGeometry Rect="132,61,0.7,0.7" />
              <RectangleGeometry Rect="7,96,0.7,0.7" />
              <RectangleGeometry Rect="33,118,0.7,0.7" />
              <RectangleGeometry Rect="59,101,0.7,0.7" />
              <RectangleGeometry Rect="92,127,0.7,0.7" />
              <RectangleGeometry Rect="117,109,0.7,0.7" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="#0CFFFFFF">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="24,33,0.7,0.7" />
              <RectangleGeometry Rect="54,18,0.7,0.7" />
              <RectangleGeometry Rect="79,44,0.7,0.7" />
              <RectangleGeometry Rect="109,38,0.7,0.7" />
              <RectangleGeometry Rect="14,78,0.7,0.7" />
              <RectangleGeometry Rect="41,92,0.7,0.7" />
              <RectangleGeometry Rect="68,84,0.7,0.7" />
              <RectangleGeometry Rect="96,99,0.7,0.7" />
              <RectangleGeometry Rect="126,88,0.7,0.7" />
              <RectangleGeometry Rect="28,131,0.7,0.7" />
              <RectangleGeometry Rect="76,116,0.7,0.7" />
              <RectangleGeometry Rect="111,133,0.7,0.7" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- A soft top-down sheen shared by every glass panel -->
  <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2EFFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="0.45" />
  </LinearGradientBrush>

  <!-- ==================== Shadows ==================== -->
  <DropShadowEffect x:Key="ShadowAmbient" BlurRadius="34" ShadowDepth="14"
                    Direction="270" Color="#3F5068" Opacity="0.17"
                    RenderingBias="Quality" />
  <DropShadowEffect x:Key="ShadowKey" BlurRadius="10" ShadowDepth="3"
                    Direction="270" Color="#33445C" Opacity="0.14"
                    RenderingBias="Quality" />
  <DropShadowEffect x:Key="ShadowSoft" BlurRadius="10" ShadowDepth="2"
                    Direction="270" Color="#3F5068" Opacity="0.11"
                    RenderingBias="Quality" />
  <DropShadowEffect x:Key="FocusGlow" BlurRadius="14" ShadowDepth="0"
                    Color="#6E8FB0" Opacity="0.28" RenderingBias="Quality" />

  <!-- ==================== Metrics ==================== -->
  <CornerRadius x:Key="RadiusControl">12</CornerRadius>
  <CornerRadius x:Key="RadiusCard">20</CornerRadius>
  <CornerRadius x:Key="RadiusInner">16</CornerRadius>

  <FontFamily x:Key="FontUi">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, Arial</FontFamily>

  <!-- ==================== Focus visual ==================== -->
  <Style x:Key="SubtleFocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3"
                  BorderBrush="{StaticResource BrushAccentGlow}"
                  BorderThickness="1.5"
                  CornerRadius="9"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== Window ==================== -->
  <Style TargetType="Window">
    <Setter Property="Background" Value="{StaticResource AppBackdrop}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <!-- ==================== Text helpers ==================== -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="DialogTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
  </Style>

  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
  </Style>

  <!-- ==================== Glass panel ==================== -->
  <!--
    A reusable glass surface: two shadow layers (a wide ambient one and a tight
    contact one), a translucent fill, fine noise, a top sheen and an inner
    highlight. ContentControl is a drop-in single-child container, so switching
    a card Border to this style changes no layout or wiring.
  -->
  <ControlTemplate x:Key="GlassPanelTemplate" TargetType="ContentControl">
    <Grid>
      <Border Background="#20FFFFFF" BorderBrush="#FFE6ECF3" BorderThickness="1"
              CornerRadius="{StaticResource RadiusCard}"
              Effect="{StaticResource ShadowAmbient}" />
      <Border Background="#20FFFFFF" BorderBrush="#FFE6ECF3" BorderThickness="1"
              CornerRadius="{StaticResource RadiusCard}"
              Effect="{StaticResource ShadowKey}" />
      <Border Background="{StaticResource GlassFill}"
              BorderBrush="{StaticResource GlassStroke}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusCard}"
              SnapsToDevicePixels="True">
        <Grid>
          <Border Background="{StaticResource NoiseOverlay}"
                  CornerRadius="{StaticResource RadiusInner}"
                  IsHitTestVisible="False" />
          <Border Background="{StaticResource GlassSheen}"
                  CornerRadius="{StaticResource RadiusInner}"
                  IsHitTestVisible="False" />
          <Border BorderBrush="{StaticResource GlassHighlight}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusInner}"
                  Margin="1"
                  IsHitTestVisible="False" />
          <ContentPresenter Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>

  <Style x:Key="GlassPanel" TargetType="ContentControl">
    <Setter Property="Template" Value="{StaticResource GlassPanelTemplate}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Kept for any remaining card Borders: single soft shadow, same glass fill -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Effect" Value="{StaticResource ShadowAmbient}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ==================== Buttons ==================== -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusControl}"
            Effect="{StaticResource ShadowSoft}"
            SnapsToDevicePixels="True">
      <ContentPresenter Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        RecognizesAccessKey="True"
                        SnapsToDevicePixels="True" />
    </Border>
  </ControlTemplate>

  <Style x:Key="ButtonBaseStyle" TargetType="ButtonBase">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Background" Value="{StaticResource GlassFillSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushFieldStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SubtleFocusVisual}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />

    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#B0FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGlow}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushAccentPressed}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource GlassFillSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== TextBox ==================== -->
  <ControlTemplate x:Key="TextBoxTemplate" TargetType="TextBox">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusControl}"
            SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Hidden"
                    Margin="{TemplateBinding Padding}" />
    </Border>
  </ControlTemplate>

  <Style x:Key="TextBoxBase" TargetType="TextBox">
    <Setter Property="Template" Value="{StaticResource TextBoxTemplate}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Background" Value="{StaticResource BrushFieldFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushFieldStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{StaticResource BrushAccent}" />
    <Setter Property="SelectionBrush" Value="{StaticResource BrushSelection}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />

    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsKeyboardFocusWithin" Value="True" />
          <Condition Property="IsReadOnly" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
        <Setter Property="Effect" Value="{StaticResource FocusGlow}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}" />

  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="Background" Value="{StaticResource BrushFieldFill}" />
  </Style>

  <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="FontFamily" Value="Consolas, Segoe UI Variable Text, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource GlassFillSoft}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentGlow}" />
        <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
        <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ResultText" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="IBeam" />
  </Style>

  <!-- ==================== CheckBox ==================== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box"
                    Width="19" Height="19"
                    CornerRadius="6"
                    Background="{StaticResource BrushFieldFill}"
                    BorderBrush="{StaticResource BrushFieldStroke}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="Check"
                    Data="M 3.5,9.5 L 7.5,13.5 L 15,5.5"
                    Stroke="White"
                    StrokeThickness="2"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Stretch="Uniform"
                    Margin="2"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource BrushAccent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BrushAccentGlow}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ComboBox ==================== -->
  <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusControl}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0"
                                Margin="14,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Path Grid.Column="1"
                    Margin="8,0,14,0"
                    VerticalAlignment="Center"
                    Data="M 0,0 L 4.5,4.5 L 9,0"
                    Stroke="{StaticResource BrushTextMuted}"
                    StrokeThickness="1.4" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccentGlow}" />
              <Setter TargetName="Bd" Property="Background" Value="#B0FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Background" Value="{StaticResource BrushFieldFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushFieldStroke}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SubtleFocusVisual}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboBoxToggleButton}"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          IsChecked="{Binding IsDropDownOpen,
                                              Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}" />

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Margin="0,6,0,0"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource GlassFill}"
                      BorderBrush="{StaticResource GlassStroke}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource RadiusControl}"
                      Effect="{StaticResource ShadowKey}"
                      SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd"
                  Background="Transparent"
                  CornerRadius="8"
                  Margin="4,2"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
              <Setter Property="Foreground" Value="{StaticResource BrushAccentHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== GroupBox (glass card section) ==================== -->
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <Border Background="#20FFFFFF" BorderBrush="#FFE6ECF3" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Effect="{StaticResource ShadowAmbient}" />
            <Border Background="#20FFFFFF" BorderBrush="#FFE6ECF3" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Effect="{StaticResource ShadowKey}" />
            <Border Background="{StaticResource GlassFill}"
                    BorderBrush="{StaticResource GlassStroke}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border Background="{StaticResource NoiseOverlay}"
                        CornerRadius="{StaticResource RadiusInner}"
                        IsHitTestVisible="False" />
                <Border Background="{StaticResource GlassSheen}"
                        CornerRadius="{StaticResource RadiusInner}"
                        IsHitTestVisible="False" />
                <Border BorderBrush="{StaticResource GlassHighlight}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusInner}"
                        Margin="1"
                        IsHitTestVisible="False" />
                <DockPanel Margin="{TemplateBinding Padding}">
                  <TextBlock DockPanel.Dock="Top"
                             Text="{TemplateBinding Header}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}"
                             Margin="0,0,0,14" />
                  <ContentPresenter />
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ListView ==================== -->
  <Style TargetType="ListView">
    <Setter Property="Background" Value="{StaticResource GlassFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Effect" Value="{StaticResource ShadowAmbient}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListView">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusCard}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border Background="{StaticResource NoiseOverlay}"
                      CornerRadius="{StaticResource RadiusInner}"
                      IsHitTestVisible="False" />
              <ScrollViewer Style="{DynamicResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderThickness="0">
                <ItemsPresenter />
              </ScrollViewer>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListViewItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0"
                  CornerRadius="9"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                  Content="{TemplateBinding Content}"
                                  SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ColumnHeaderGripper" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridViewColumnHeader">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="{StaticResource BrushDivider}"
                  BorderThickness="0,0,0,1"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
              <Thumb x:Name="PART_HeaderGripper"
                     Style="{StaticResource ColumnHeaderGripper}"
                     HorizontalAlignment="Right"
                     Width="8"
                     Margin="0,0,-6,0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== ScrollBar ==================== -->
  <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd"
                  Background="{StaticResource BrushScrollThumb}"
                  CornerRadius="3"
                  Margin="2"
                  SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushScrollThumbHover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushScrollThumbHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Track x:Name="PART_Track" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBarPageButton}" />
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="7" />
    <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== ToolTip ==================== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource GlassFill}"
                  BorderBrush="{StaticResource GlassStroke}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource RadiusControl}"
                  Padding="12,8"
                  Effect="{StaticResource ShadowKey}"
                  SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
