<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <LangVersion>12</LangVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>LocalTrayTranslate</AssemblyName>
    <RootNamespace>TranslateLite</RootNamespace>

    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.1.2</Version>
    <Product>LocalTrayTranslate</Product>
    <AssemblyTitle>LocalTrayTranslate</AssemblyTitle>
    <Description>LTT - 轻量翻译词典工具</Description>
    <Authors>makabaka</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\dictionary.db"
          Link="dictionary.db"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\data\dictionary.db')" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
</Project>
