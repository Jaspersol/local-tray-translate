<Window x:Class="TranslateLite.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp">
  <Canvas x:Name="RootCanvas">
    <Image x:Name="ScreenImage" Stretch="Fill" IsHitTestVisible="False" />
    <Path x:Name="DimMask" Fill="#4A1C2531" IsHitTestVisible="False" />
    <Rectangle x:Name="SelectionBorder"
               Visibility="Collapsed"
               Stroke="{DynamicResource BrushAccent}"
               StrokeThickness="1.5"
               RadiusX="6"
               RadiusY="6"
               IsHitTestVisible="False" />
  </Canvas>
</Window>
