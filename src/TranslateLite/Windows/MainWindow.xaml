<Window x:Class="TranslateLite.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranslateLite"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="360"
        Closing="OnClosing">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="4,0,4,14" LastChildFill="True">
      <Button Content="用户词典"
              DockPanel.Dock="Right"
              Style="{StaticResource GhostButton}"
              Margin="0"
              Click="OnUserDictionaryClick" />
      <TextBlock Text="TranslateLite"
                 Style="{StaticResource PageTitle}" />
    </DockPanel>

    <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,0,0,14">
      <Button Content="查询"
              DockPanel.Dock="Right"
              Style="{StaticResource PrimaryButton}"
              MinWidth="72"
              Margin="8,0,0,0"
              Click="OnLookupClicked" />
      <TextBox x:Name="QueryBox"
               Style="{StaticResource SearchBox}"
               Margin="0"
               KeyDown="OnQueryKeyDown" />
    </DockPanel>

    <Border Grid.Row="2"
            Style="{StaticResource Card}"
            Padding="16,12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ResultsList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource BrushBorder}"
                      BorderThickness="0,0,0,1"
                      Padding="0,12">
                <StackPanel>
                  <DockPanel>
                    <TextBox Text="{Binding Word, Mode=OneWay}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource BrushTextPrimary}"
                             Style="{StaticResource ResultText}" />
                    <TextBox Text="{Binding Phonetic, Mode=OneWay}"
                             FontSize="13"
                             Foreground="{StaticResource BrushTextMuted}"
                             Margin="10,4,0,0"
                             Style="{StaticResource ResultText}" />
                  </DockPanel>
                  <TextBox Text="{Binding Translation, Mode=OneWay}"
                           FontSize="15"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,8,0,0"
                           Style="{StaticResource ResultText}" />
                  <TextBox Text="{Binding Definition, Mode=OneWay}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Margin="0,4,0,0"
                           Style="{StaticResource ResultText}" />
                  <TextBox Text="{Binding Example, Mode=OneWay}"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontStyle="Italic"
                           Margin="0,6,0,0"
                           Style="{StaticResource ResultText}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
