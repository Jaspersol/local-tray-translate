<Window x:Class="TranslateLite.Windows.ResultPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查询结果"
        Width="500"
        Height="460"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Closing="OnClosing">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,18">
      <Button Content="查询"
              DockPanel.Dock="Right"
              Style="{StaticResource PrimaryButton}"
              Width="60"
              Margin="12,0,0,0"
              Click="OnQueryClicked" />
      <TextBox x:Name="QueryBox"
               Style="{StaticResource SearchBox}"
               FontSize="16"
               FontWeight="SemiBold"
               Margin="0"
               KeyDown="OnQueryKeyDown" />
    </DockPanel>

    <ContentControl Grid.Row="1"
                    Style="{StaticResource GlassPanel}"
                    Padding="22,18">
      <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ResultPanel" />
      </ScrollViewer>
    </ContentControl>
  </Grid>
</Window>
