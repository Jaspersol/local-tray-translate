<Window x:Class="TranslateLite.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="440"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="划词翻译" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="点击下方输入框，然后按下你想要的快捷键组合"
                           Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <TextBox x:Name="SelectionHotkeyBox" Grid.Row="1"
                         Style="{StaticResource HotkeyBox}"
                         Margin="0"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         PreviewKeyDown="OnSelectionHotkeyPreviewKeyDown"
                         GotFocus="OnHotkeyBoxGotFocus"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="截图翻译" Grid.Row="1" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="点击下方输入框，然后按下你想要的快捷键组合"
                           Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <TextBox x:Name="ScreenOcrHotkeyBox" Grid.Row="1"
                         Style="{StaticResource HotkeyBox}"
                         Margin="0"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         PreviewKeyDown="OnScreenOcrHotkeyPreviewKeyDown"
                         GotFocus="OnHotkeyBoxGotFocus"/>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Style="{StaticResource Hint}"
                   Foreground="{StaticResource BrushDanger}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="2,4,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="取消"
                    Style="{StaticResource GhostButton}"
                    Click="OnCancelClick"
                    Width="84"
                    Margin="0,0,8,0" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Width="84" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
