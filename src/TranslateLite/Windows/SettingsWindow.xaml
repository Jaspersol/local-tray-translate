<Window x:Class="TranslateLite.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        Height="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="划词翻译" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="点击下方输入框，然后按下你想要的快捷键组合"
                               Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                    <TextBox x:Name="SelectionHotkeyBox" Grid.Row="1"
                             Style="{StaticResource HotkeyBox}"
                             Margin="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             PreviewKeyDown="OnSelectionHotkeyPreviewKeyDown"
                             GotFocus="OnHotkeyBoxGotFocus"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="截图翻译" Grid.Row="1" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="点击下方输入框，然后按下你想要的快捷键组合"
                               Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                    <TextBox x:Name="ScreenOcrHotkeyBox" Grid.Row="1"
                             Style="{StaticResource HotkeyBox}"
                             Margin="0"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             PreviewKeyDown="OnScreenOcrHotkeyPreviewKeyDown"
                             GotFocus="OnHotkeyBoxGotFocus"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="常规" Grid.Row="2" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="开机自动启动"
                              VerticalContentAlignment="Center" />
                    <TextBlock Text="登录 Windows 后自动在后台启动并驻留托盘"
                               Style="{StaticResource Hint}" Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="关于与更新" Grid.Row="3" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="LTT" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText" Text="v—" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <Button x:Name="CheckUpdateButton" Content="检查更新" DockPanel.Dock="Right"
                                HorizontalAlignment="Right" MinWidth="96"
                                Style="{StaticResource GhostButton}" Click="OnCheckUpdateClick"/>
                    </DockPanel>

                    <CheckBox x:Name="AutoCheckUpdateCheckBox"
                              Content="启动时自动检查更新（每 6 小时最多一次）"
                              VerticalContentAlignment="Center" />
                    <TextBlock Text="优先走 GitHub API；被限流或不可达时改用直链通道。只提示，不自动下载。"
                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Border x:Name="UpdateBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="12"
                            Background="{StaticResource BrushSurfaceSunken}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <ScrollViewer x:Name="NotesViewer" Visibility="Collapsed" MaxHeight="110"
                                          VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                                <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap"
                                           Style="{StaticResource Hint}"/>
                            </ScrollViewer>
                            <ProgressBar x:Name="UpdateProgressBar" Visibility="Collapsed" Height="6"
                                         Margin="0,10,0,0" Minimum="0" Maximum="100"/>
                            <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <Button x:Name="InstallButton" Content="下载并安装" MinWidth="110"
                                        Style="{StaticResource PrimaryButton}" Click="OnInstallUpdateClick"/>
                                <Button x:Name="ReleasePageButton" Content="在 GitHub 查看" MinWidth="110"
                                        Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                        Click="OnOpenReleasePageClick"/>
                                <TextBlock x:Name="AssetSizeText" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="ValidationText"
                       Grid.Row="4"
                       Style="{StaticResource Hint}"
                       Foreground="{StaticResource BrushDanger}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="4,6,0,0" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消"
                        Style="{StaticResource GhostButton}"
                        Click="OnCancelClick"
                        Width="84"
                        Margin="0,0,8,0" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Width="84" Margin="0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
