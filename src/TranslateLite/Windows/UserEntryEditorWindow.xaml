<Window x:Class="TranslateLite.Windows.UserEntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="词条编辑"
        Width="520"
        Height="600"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="92" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="词条:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="WordBox" Grid.Row="0" Grid.Column="1" Margin="0,7" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="语言:" Style="{StaticResource FieldLabel}" />
    <ComboBox x:Name="LangBox"
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,7"
              Width="120"
              HorizontalAlignment="Left"
              SelectedIndex="0">
      <ComboBoxItem Content="en" Tag="en" />
      <ComboBoxItem Content="zh" Tag="zh" />
    </ComboBox>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="音标:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="PhoneticBox" Grid.Row="2" Grid.Column="1" Margin="0,7" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="翻译:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TranslationBox" Grid.Row="3" Grid.Column="1" Margin="0,7" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="释义:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="DefinitionBox" Grid.Row="4" Grid.Column="1" Margin="0,7" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="例句:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="ExampleBox" Grid.Row="5" Grid.Column="1" Margin="0,7" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="标签:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TagsBox" Grid.Row="6" Grid.Column="1" Margin="0,7" ToolTip="逗号分隔，如: 工作,待背" />

    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Content="保存"
              Style="{StaticResource PrimaryButton}"
              Click="OnSaveClick"
              Width="84"
              Margin="0,0,8,0"
              IsDefault="True" />
      <Button Content="取消"
              Style="{StaticResource GhostButton}"
              Click="OnCancelClick"
              Width="84"
              Margin="0"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
