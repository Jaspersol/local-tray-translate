<Window x:Class="TranslateLite.Windows.UserEntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x8bcd;&#x6761;&#x7f16;&#x8f91;"
        Width="480"
        Height="480"
        MinWidth="420"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="72" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x8BCD;&#x6761;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="WordBox" Grid.Row="0" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x8BED;&#x8A00;:" Style="{StaticResource FieldLabel}" />
    <ComboBox x:Name="LangBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="120" HorizontalAlignment="Left" SelectedIndex="0">
      <ComboBoxItem Content="en" Tag="en" />
      <ComboBoxItem Content="zh" Tag="zh" />
    </ComboBox>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="&#x97F3;&#x6807;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="PhoneticBox" Grid.Row="2" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="&#x7FFB;&#x8BD1;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TranslationBox" Grid.Row="3" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="&#x91CA;&#x4E49;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="DefinitionBox" Grid.Row="4" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="&#x4F8B;&#x53E5;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="ExampleBox" Grid.Row="5" Grid.Column="1" Margin="0,4" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="&#x6807;&#x7B7E;:" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TagsBox" Grid.Row="6" Grid.Column="1" Margin="0,4" ToolTip="&#x9017;&#x53F7;&#x5206;&#x9694;&#xFF0C;&#x5982;: &#x5DE5;&#x4F5C;,&#x5F85;&#x80CC;" />

    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="&#x4FDD;&#x5B58;" Style="{StaticResource PrimaryButton}" Click="OnSaveClick" Width="84" Margin="0,0,8,0" IsDefault="True" />
      <Button Content="&#x53D6;&#x6D88;" Style="{StaticResource GhostButton}" Click="OnCancelClick" Width="84" Margin="0" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
